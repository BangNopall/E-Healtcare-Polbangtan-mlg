# ==============================================================================
# Environment Configuration Template for E-Polbangtan HealtCare (Production)
# ==============================================================================

APP_NAME="E-Polbangtan Healt Care"
APP_AUTHOR="Developer SMK TELKOM MALANG & Polbangtan Malang"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8001

# Port publik aplikasi pada host VPS Debian
DOCKER_APP_PORT=8001

# Otomasi migrasi saat kontainer start (true / false)
RUN_MIGRATIONS=true

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Database MySQL (Terkoneksi ke service klinik-db dalam Docker)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=klinik-db
DB_PORT=3306
DB_DATABASE=polbangtan_healtcare
DB_USERNAME=klinik_user
DB_PASSWORD=GantiDenganPasswordDatabaseYangKuat123!
DB_ROOT_PASSWORD=GantiDenganPasswordRootYangSangatKuat456!

# ------------------------------------------------------------------------------
# Redis 7 In-Memory Engine (Terkoneksi ke service klinik-redis)
# ------------------------------------------------------------------------------
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=klinik-redis
REDIS_PASSWORD=GantiDenganPasswordRedisKuat789!
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Session Security Settings (Pencegah Error 419 Page Expired)
# PENTING: Set 'false' jika mengakses via HTTP/IP server (http://<IP-VPS>:8001).
# Ubah menjadi 'true' HANYA jika domain sudah terpasang sertifikat SSL/HTTPS!
# ------------------------------------------------------------------------------
SESSION_LIFETIME=120
SESSION_COOKIE=klinik_session
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=
CLOCKWORK_ENABLE=false

# ------------------------------------------------------------------------------
# Filesystem Storage
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# SSO Integration dengan E-Management
# Pastikan SSO_SHARED_SECRET identik dengan yang ada di E-Management
# ------------------------------------------------------------------------------
SSO_SHARED_SECRET=GantiDenganSecretKeyBersamaYangPanjangMinimal32Karakter
MANAGEMENT_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Email Mailer (SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="klinik@polbangtanmalang.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Vite Frontend Environment
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
